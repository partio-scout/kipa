# Kopioi tämä tiedosto nimelle .env ja vaihda salasanat omiksesi.
# Käytä salasanoissa vain kirjaimia ja numeroita (ei välilyöntejä, $-merkkejä tai lainausmerkkejä).

# Tietokannan salasanat. ÄLÄ vaihda näitä enää ensimmäisen käynnistyksen jälkeen.
KIPA_DB_PASSWORD=vaihdaTama1
MYSQL_ROOT_PASSWORD=vaihdaTama2

# Kipan pääkäyttäjä. Luodaan ensimmäisellä käynnistyksellä, jos sitä ei vielä ole.
KIPA_ADMIN_USER=admin
KIPA_ADMIN_PASSWORD=vaihdaTama3

# Osoitteet, joilla Kipaan saa yhteyden muilta koneilta, pilkulla eroteltuina.
# * = mikä tahansa osoite (helpoin lähiverkossa). Pelkälle omalle koneelle: localhost,127.0.0.1
# Internetiin avoimella palvelimella käytä omaa verkkotunnusta, esim. kipa.example.fi
KIPA_ALLOWED_HOSTS=*
